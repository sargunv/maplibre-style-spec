diff --git a/src/style/latitude.test.ts b/src/style/latitude.test.ts
new file mode 100644
index 000000000..7bbebaa8b
--- /dev/null
+++ b/src/style/latitude.test.ts
@@ -0,0 +1,48 @@
+import {describe, expect, test} from 'vitest';
+import {createStyleLayer} from './create_style_layer.ts';
+import {EvaluationParameters} from './evaluation_parameters.ts';
+import {bindCameraParameters} from './bind_camera_parameters.ts';
+import {LineFloorwidthProperty} from './style_layer/line_style_layer.ts';
+import lineProperties from './style_layer/line_style_layer_properties.g.ts';
+import {PropertyValue} from './properties.ts';
+import type {LineStyleLayer} from './style_layer/line_style_layer.ts';
+import type {LayerSpecification} from '@maplibre/maplibre-gl-style-spec';
+
+describe('camera latitude', () => {
+    test('recalculates road width and integer-zoom floor width at constant zoom', () => {
+        const layer = createStyleLayer({id: 'road', type: 'line', source: 'roads', paint: {
+            'line-width': ['interpolate', ['exponential', 2], ['zoom'],
+                0, ['/', 1, ['cos', ['*', ['latitude'], ['/', ['pi'], 180]]]],
+                1, ['/', 2, ['cos', ['*', ['latitude'], ['/', ['pi'], 180]]]]]
+        }}, {}) as LineStyleLayer;
+        expect(layer.isViewDependent).toBe(true);
+        expect(layer.viewRequiresRelayout).toBe(false);
+        for (const latitude of [0, 60, -60]) {
+            layer.recalculate(new EvaluationParameters(0.5, {latitude}), []);
+            const scale = 1 / Math.cos(latitude * Math.PI / 180);
+            expect(layer.paint.get('line-width').constantOr(0)).toBeCloseTo(Math.SQRT2 * scale);
+            const floor = new LineFloorwidthProperty(lineProperties.paint.properties['line-width'].specification, 'line-floorwidth');
+            const value = new PropertyValue(floor, layer.getPaintProperty('line-width'), 'line-width', {});
+            expect(floor.possiblyEvaluate(value, new EvaluationParameters(0.5, {latitude})).constantOr(0)).toBeCloseTo(scale);
+        }
+    });
+
+    test('binds worker snapshots for feature paint and layout without changing the public style', () => {
+        const definition: LayerSpecification = {id: 'road', type: 'line', source: 'roads',
+            metadata: {example: ['latitude']},
+            layout: {'line-sort-key': ['abs', ['latitude']]},
+            paint: {'line-width': ['+', ['abs', ['latitude']], ['get', 'width']]}
+        };
+        const layer = createStyleLayer(definition, {}) as LineStyleLayer;
+        expect(layer.viewRequiresRelayout).toBe(true);
+        const worker = createStyleLayer(bindCameraParameters(definition, -60), {}) as LineStyleLayer;
+        worker.recalculate(new EvaluationParameters(0), []);
+        expect(worker.paint.get('line-width').evaluate({type: 2, properties: {width: 7}}, {})).toBe(67);
+        expect(worker.layout.get('line-sort-key').constantOr(0)).toBe(60);
+        expect(worker.isViewDependent).toBe(false);
+        expect(layer.getPaintProperty('line-width')).toEqual(definition.paint['line-width']);
+        expect(bindCameraParameters(definition, 10).metadata).toEqual(definition.metadata);
+        const literal: LayerSpecification = {id: 'symbol', type: 'symbol', source: 'roads', layout: {'text-font': ['literal', ['latitude']]}};
+        expect(bindCameraParameters(literal, 60)).toEqual(literal);
+    });
+});
