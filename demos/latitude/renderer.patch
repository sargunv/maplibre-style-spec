--- /dev/null
+++ b/src/style/bind_camera_parameters.ts
@@ -0,0 +1,31 @@
+import type {LayerSpecification} from '@maplibre/maplibre-gl-style-spec';
+
+/**
+ * Binds camera latitude and scale in worker paint and layout expressions to a tile-build snapshot.
+ * Literal data, source metadata, and the main-thread style remain unchanged. Workers can then
+ * use their existing zoom/feature evaluation and buffer construction paths.
+ */
+export function bindCameraParameters(layer: LayerSpecification, latitude: number | undefined, scale?: number): LayerSpecification {
+    if (latitude === undefined && scale === undefined) return layer;
+    const result = {...layer};
+    for (const section of ['paint', 'layout'] as const) {
+        if (!layer[section]) continue;
+        result[section] = Object.fromEntries(Object.entries(layer[section]).map(([name, value]) =>
+            [name, bindValue(value, latitude, scale)]));
+    }
+    return result;
+}
+
+/** Recursively binds expression arguments, including formatting options, while preserving literals. */
+function bindValue(value: unknown, latitude: number | undefined, scale?: number): unknown {
+    if (Array.isArray(value)) {
+        if (value[0] === 'literal') return value;
+        if (value.length === 1 && value[0] === 'latitude' && latitude !== undefined) return latitude;
+        if (value.length === 1 && value[0] === 'scale' && scale !== undefined) return scale;
+        return value.map(argument => bindValue(argument, latitude, scale));
+    }
+    if (value && typeof value === 'object') {
+        return Object.fromEntries(Object.entries(value).map(([key, argument]) => [key, bindValue(argument, latitude, scale)]));
+    }
+    return value;
+}
